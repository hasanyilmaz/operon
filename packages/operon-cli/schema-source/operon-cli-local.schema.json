{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operon:schema:cli:v1:operon-cli-local.schema.json",
  "title": "Operon CLI local V1",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "canonicalPath",
        "vaultSha256",
        "verifiedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "canonicalPath": {
          "type": "string",
          "minLength": 1
        },
        "vaultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profiles"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "defaultProfile": {
          "type": "string"
        },
        "profiles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "planRef",
        "vaultSha256",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "planRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        },
        "vaultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "mutationPlanReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "kind",
        "planRef"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "kind": {
          "const": "mutation-plan-reference"
        },
        "planRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{31}$"
        },
        "confirmationToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "mutationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "kind",
        "spec"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "kind": {
          "const": "mutation-intent"
        },
        "requestId": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/exactMutationTarget"
        },
        "spec": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/mutationPreviewSpec"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "publicPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "confirmationToken",
        "capability",
        "mutationKind",
        "createdAt",
        "expiresAt",
        "targets",
        "atomicGroups",
        "predictedEffects",
        "riskLevel",
        "requiresConfirmation",
        "requiredAcknowledgements",
        "warnings",
        "spec"
      ],
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confirmationToken": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "capability": {
          "type": "string",
          "enum": [
            "tasks.create.preview",
            "tasks.update.preview",
            "tasks.recurrence.preview",
            "tasks.relationship.preview",
            "tasks.reminder.preview",
            "tasks.transition.preview",
            "tasks.pinned.preview",
            "timers.control.preview",
            "timers.session.preview",
            "tasks.convert.preview",
            "tasks.inline.relocate.preview",
            "tasks.delete.preview"
          ]
        },
        "mutationKind": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/mutationKind"
        },
        "createdAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "expiresAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "targets": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/planTarget"
          }
        },
        "atomicGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/atomicGroup"
          }
        },
        "predictedEffects": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/predictedEffect"
          }
        },
        "riskLevel": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/riskLevel"
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "requiredAcknowledgements": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning"
          }
        },
        "spec": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/mutationSpec"
        },
        "createEffects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/sealedCreateEffect"
          }
        },
        "conversionEffect": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/sealedConversionEffect"
        }
      }
    },
    "planShowResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planRef",
        "createdAt",
        "expiresAt",
        "plan"
      ],
      "properties": {
        "planRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "plan": {
          "$ref": "#/$defs/publicPlan"
        },
        "lastOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "mutationMayHaveApplied",
            "retryAllowed"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "applied",
                "already-applied",
                "partial",
                "failed",
                "outcome-unknown"
              ]
            },
            "mutationMayHaveApplied": {
              "type": "boolean"
            },
            "retryAllowed": {
              "type": "boolean"
            },
            "ambiguitySource": {
              "type": "string",
              "enum": [
                "group-outcome",
                "receipt-persist-failure"
              ]
            }
          }
        }
      }
    },
    "pluginManifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "version",
        "minAppVersion"
      ],
      "properties": {
        "id": {
          "const": "operon"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "minAppVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "versionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "node",
        "platform"
      ],
      "properties": {
        "name": {
          "const": "operon-cli"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "pattern": "^v[0-9]+\\."
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaListPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "entrypoints"
      ],
      "properties": {
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.json$"
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaId",
              "ref"
            ],
            "properties": {
              "schemaId": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+$"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "schemaGetPayload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "$schema",
            "$id"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "$id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "ref",
            "document"
          ],
          "properties": {
            "schemaId": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "document": {
              "type": "object",
              "required": [
                "$schema",
                "$id"
              ],
              "properties": {
                "$schema": {
                  "const": "https://json-schema.org/draft/2020-12/schema"
                },
                "$id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "cancelledPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled"
      ],
      "properties": {
        "cancelled": {
          "const": true
        }
      }
    },
    "setupPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/cancelledPayload"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "plugin"
          ],
          "properties": {
            "profile": {
              "$ref": "#/$defs/profile"
            },
            "plugin": {
              "$ref": "#/$defs/pluginManifest"
            },
            "live": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "doctorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "vault",
        "plugin"
      ],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "liveTransport"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "liveTransport": {
              "type": "string",
              "enum": [
                "supported",
                "acceptance-required",
                "unsupported"
              ]
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "secure",
            "repaired"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "posix-mode",
                "windows-dacl"
              ]
            },
            "secure": {
              "type": "boolean"
            },
            "repaired": {
              "type": "boolean"
            },
            "failureReason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "vault": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "canonicalPath",
            "sha256"
          ],
          "properties": {
            "canonicalPath": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "plugin": {
          "$ref": "#/$defs/pluginManifest"
        },
        "live": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "planDiscardPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planRef",
        "discarded"
      ],
      "properties": {
        "planRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{31}$"
        },
        "discarded": {
          "type": "boolean"
        }
      }
    },
    "planRecoverPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/cancelledPayload"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recoverableCount"
          ],
          "properties": {
            "recoverableCount": {
              "const": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planRef",
            "abandoned"
          ],
          "properties": {
            "planRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{31}$"
            },
            "abandoned": {
              "const": true
            }
          }
        }
      ]
    },
    "localResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contractVersion",
        "kind",
        "command",
        "ok"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "kind": {
          "const": "operon-cli-local-result"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "planRef",
            "action",
            "mutationMayHaveApplied"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "planRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{31}$"
            },
            "action": {
              "const": "recover-same-plan"
            },
            "mutationMayHaveApplied": {
              "const": true
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "recovery"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          },
          "if": {
            "required": [
              "recovery"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "outcome-unknown"
                      },
                      "retryable": {
                        "const": false
                      },
                      "action": {
                        "const": "recover-same-plan"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "versionResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "version"
            },
            "result": {
              "$ref": "#/$defs/versionPayload"
            }
          }
        }
      ]
    },
    "manifestResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "manifest"
            },
            "result": {
              "$ref": "urn:operon:schema:cli:v1:cli-manifest.schema.json"
            }
          }
        }
      ]
    },
    "schemaListResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "schema.list"
            },
            "result": {
              "$ref": "#/$defs/schemaListPayload"
            }
          }
        }
      ]
    },
    "schemaGetResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "schema.get"
            },
            "result": {
              "$ref": "#/$defs/schemaGetPayload"
            }
          }
        }
      ]
    },
    "setupResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "setup"
            },
            "result": {
              "$ref": "#/$defs/setupPayload"
            }
          }
        }
      ]
    },
    "doctorResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "doctor"
            },
            "result": {
              "$ref": "#/$defs/doctorPayload"
            }
          }
        }
      ]
    },
    "profileListResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "profile.list"
            },
            "result": {
              "$ref": "#/$defs/config"
            }
          }
        }
      ]
    },
    "profileDefaultResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "profile.default"
            },
            "result": {
              "$ref": "#/$defs/config"
            }
          }
        }
      ]
    },
    "profileRemoveResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "profile.remove"
            },
            "result": {
              "$ref": "#/$defs/config"
            }
          }
        }
      ]
    },
    "planShowEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "plan.show"
            },
            "result": {
              "$ref": "#/$defs/planShowResult"
            }
          }
        }
      ]
    },
    "planDiscardResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "plan.discard"
            },
            "result": {
              "$ref": "#/$defs/planDiscardPayload"
            }
          }
        }
      ]
    },
    "planApplyLocalResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "plan.apply"
            },
            "ok": {
              "const": false
            }
          }
        }
      ]
    },
    "planRecoverLocalResult": {
      "allOf": [
        {
          "$ref": "#/$defs/localResult"
        },
        {
          "properties": {
            "command": {
              "const": "plan.recover"
            },
            "result": {
              "$ref": "#/$defs/planRecoverPayload"
            }
          }
        }
      ]
    }
  }
}
