{
  "name": "operon-cli",
  "version": "1.0.5",
  "description": "Official command-line client for the Operon Agent Runtime in Obsidian.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Hasan Yilmaz",
  "homepage": "https://github.com/hasanyilmaz/operon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanyilmaz/operon.git",
    "directory": "packages/operon-cli"
  },
  "bugs": {
    "url": "https://github.com/hasanyilmaz/operon/issues"
  },
  "keywords": [
    "obsidian",
    "operon",
    "tasks",
    "agents",
    "cli"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "operon": "./dist/operon.mjs"
  },
  "exports": {
    "./contracts/v1": {
      "types": "./types/src/agent-runtime/public/v1/index.d.ts",
      "default": null
    },
    "./contracts/v1/developer-api": {
      "types": "./types/src/agent-runtime/public/v1/developer-api.d.ts",
      "default": null
    },
    "./contracts/v1/cli": {
      "types": "./types/src/agent-runtime/public/v1/cli.d.ts",
      "default": null
    }
  },
  "typesVersions": {
    "*": {
      "contracts/v1": [
        "types/src/agent-runtime/public/v1/index.d.ts"
      ],
      "contracts/v1/developer-api": [
        "types/src/agent-runtime/public/v1/developer-api.d.ts"
      ],
      "contracts/v1/cli": [
        "types/src/agent-runtime/public/v1/cli.d.ts"
      ],
      "*": [
        "types/not-exported.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*.mjs",
    "schemas/v1/*.json",
    "types/**/*.d.ts",
    "examples/developer-api-consumer/**",
    "cli-manifest-v1.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "types:write": "node type-build.mjs --write",
    "types:check": "node type-build.mjs --check",
    "types:consumer:test": "node type-consumer.test.mjs"
  }
}
