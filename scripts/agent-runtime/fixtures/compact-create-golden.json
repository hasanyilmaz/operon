{
  "schemaVersion": 1,
  "contract": {
    "command": "operon task create",
    "representation": "optional-inline-or-file",
    "fieldKeys": "canonical-only",
    "duplicateKeys": "reject",
    "listDelimiter": "semicolon-canonical-space",
    "rawStdinQuotes": "straight-double-required",
    "inlineValueParity": "semantic-values-only",
    "temporalCreate": "atomic-v1",
    "temporalCreateVersion": 1,
    "temporalCreateKeys": ["reminderDatetimes", "reminderRules", "repeat", "datetimeRepeatEnd"]
  },
  "serializerFixture": {
    "file": "canonical-golden.json",
    "caseId": "inline-reminders-custom-unicode"
  },
  "cases": [
    {
      "id": "legacy-empty-create",
      "channel": "argv",
      "argv": ["task", "create"],
      "expect": { "route": "legacy-guided" }
    },
    {
      "id": "legacy-single-description",
      "channel": "argv",
      "argv": ["task", "create", "Review"],
      "expect": { "route": "legacy-guided" }
    },
    {
      "id": "legacy-single-inline-word",
      "channel": "argv",
      "argv": ["task", "create", "inline"],
      "expect": { "route": "legacy-guided" }
