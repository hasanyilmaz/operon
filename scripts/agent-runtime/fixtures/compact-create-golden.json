    {
      "id": "configured-default-representation",
      "channel": "argv",
      "argv": ["task", "create", "Test task", "status::Daily.Planned"],
      "displayCommand": "operon task create \"Test task\" status::\"EXACT LIVE PIPELINE.STATUS\"",
      "expect": {
        "route": "compact",
        "description": "Test task",
        "representation": null,
        "target": { "mode": "configured-default" },
        "assignments": [
          { "key": "status", "value": "Daily.Planned", "valueType": "status" }
        ]
      }
    },
