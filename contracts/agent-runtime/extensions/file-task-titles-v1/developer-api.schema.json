{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api",
  "title": "File Task titles V1 developer-api",
  "$defs": {
    "accessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "runtimeApi",
        "requestedCapabilities"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "runtimeApi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requestedCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:capabilities#/$defs/capabilityId"
          }
        }
      }
    },
    "previewIntent": {
      "oneOf": [
        {
          "type": "object",
          "x-operon-maxUtf8Bytes": 786432,
          "additionalProperties": false,
          "required": [
            "capability",
            "mutationKind",
            "spec"
          ],
          "properties": {
            "capability": {
              "const": "tasks.file.create.preview"
            },
            "mutationKind": {
              "const": "task.create"
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "item"
              ],
              "properties": {
                "operation": {
                  "const": "create-file"
                },
                "item": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "itemRef",
                    "target",
                    "fields",
                    "displayTitle"
                  ],
                  "properties": {
                    "itemRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "target": {
                      "allOf": [
                        {
                          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createTarget"
                        },
                        {
                          "type": "object",
                          "required": [
                            "representation"
                          ],
                          "properties": {
                            "representation": {
                              "const": "file"
                            }
                          }
                        }
                      ]
                    },
                    "fields": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createFieldItem"
                      }
                    },
                    "tags": {
                      "type": "array",
                      "maxItems": 512,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 65536,
                        "pattern": "^(?=.*[^0-9])[^\\s#,[\\]{}|\\\\^]+$",
                        "x-operon-maxUtf8Bytes": 65536
                      }
                    },
                    "statusId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
                      "x-operon-maxUtf8Bytes": 256
                    },
                    "priorityId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
                      "x-operon-maxUtf8Bytes": 256
                    },
                    "parent": {
                      "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createReference"
                    },
                    "related": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createReference"
                      }
                    },
                    "dependencies": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createDependency"
                      }
                    },
                    "bodyMarkdown": {
                      "type": "string",
                      "maxLength": 65536,
                      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$",
                      "x-operon-maxUtf8Bytes": 65536
                    },
                    "displayTitle": {
                      "allOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16384,
                          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
                          "x-operon-maxUtf8Bytes": 16384
                        },
                        {
                          "type": "string",
                          "maxLength": 8192,
                          "x-operon-maxUtf8Bytes": 8192,
                          "minLength": 1
                        }
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "required": [
                          "bodyMarkdown"
                        ]
                      },
                      "then": {
                        "properties": {
                          "target": {
                            "properties": {
                              "representation": {
                                "const": "file"
                              }
                            },
                            "required": [
                              "representation"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "x-operon-maxUtf8Bytes": 786432,
          "additionalProperties": false,
          "required": [
            "capability",
            "mutationKind",
            "spec",
            "target"
          ],
          "properties": {
            "capability": {
              "const": "tasks.file.title.preview"
            },
            "mutationKind": {
              "const": "task.update"
            },
            "target": {
              "allOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operonId",
                    "locator"
                  ],
                  "properties": {
                    "operonId": {
                      "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId"
                    },
                    "locator": {
                      "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/taskSourceLocator"
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "locator": {
                      "type": "object",
                      "properties": {
                        "representation": {
                          "const": "file"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "displayTitle"
              ],
              "properties": {
                "operation": {
                  "const": "set-title"
                },
                "displayTitle": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 8192,
                      "x-operon-maxUtf8Bytes": 8192
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "planHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "kind",
        "recoveryRef",
        "planDigest",
        "createdAt",
        "expiresAt",
        "riskLevel",
        "requiresConsent"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "kind": {
          "const": "file-task-titles-developer-mutation-plan"
        },
        "recoveryRef": {
          "type": "string",
          "pattern": "^dvr1_[0-9a-f]{48}$"
        },
        "planDigest": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "createdAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "expiresAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "riskLevel": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/riskLevel"
        },
        "requiresConsent": {
          "type": "boolean"
        }
      }
    },
    "applyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/planHandle"
        }
      }
    },
    "recoverInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan"
          ],
          "properties": {
            "plan": {
              "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/planHandle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recoveryRef"
          ],
          "properties": {
            "recoveryRef": {
              "type": "string",
              "pattern": "^dvr1_[0-9a-f]{48}$"
            }
          }
        }
      ]
    },
    "previewResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "kind",
            "requestId",
            "ok",
            "plan",
            "warnings"
          ],
          "properties": {
            "contractVersion": {
              "const": 1
            },
            "kind": {
              "const": "file-task-titles-developer-mutation-preview-result"
            },
            "requestId": {
              "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId"
            },
            "ok": {
              "const": true
            },
            "plan": {
              "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/planHandle"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "kind",
            "requestId",
            "ok",
            "error",
            "warnings"
          ],
          "properties": {
            "contractVersion": {
              "const": 1
            },
            "kind": {
              "const": "file-task-titles-developer-mutation-preview-result"
            },
            "requestId": {
              "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId"
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning"
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "planDigest",
        "mutationKind",
        "targetDigest",
        "terminalOutcome",
        "effectiveAt",
        "completedAt",
        "expiresAt"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "planDigest": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "mutationKind": {
          "enum": [
            "task.create",
            "task.adopt",
            "task.inline-relocate",
            "task.convert"
          ]
        },
        "targetDigest": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "terminalOutcome": {
          "type": "string",
          "enum": [
            "applied",
            "already-applied"
          ]
        },
        "effectiveAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "completedAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "expiresAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "clientInstanceId"
            ]
          },
          {
            "required": [
              "idempotencyKey"
            ]
          },
          {
            "required": [
              "idempotencyKeyHash"
            ]
          },
          {
            "required": [
              "vaultIdentityHash"
            ]
          },
          {
            "required": [
              "planHash"
            ]
          },
          {
            "required": [
              "planRef"
            ]
          }
        ]
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "action",
        "mutationMayHaveApplied",
        "recoveryRef",
        "planDigest",
        "plan"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "action": {
          "const": "recover-same-plan"
        },
        "mutationMayHaveApplied": {
          "const": true
        },
        "recoveryRef": {
          "$ref": "urn:operon:schema:runtime:v1:developer-api.schema.json#/$defs/recoveryRef"
        },
        "planDigest": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "plan": {
          "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/planHandle"
        }
      }
    },
    "executionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "kind",
        "requestId",
        "status",
        "mutationMayHaveApplied",
        "retryAllowed",
        "groupResults"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "kind": {
          "const": "file-task-titles-developer-mutation-execution-result"
        },
        "requestId": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId"
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "already-applied",
            "partial",
            "failed",
            "outcome-unknown"
          ]
        },
        "mutationMayHaveApplied": {
          "type": "boolean"
        },
        "retryAllowed": {
          "type": "boolean"
        },
        "groupResults": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/atomicGroupResult"
          }
        },
        "receipt": {
          "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/receipt"
        },
        "postflight": {
          "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/mutationPostflight"
        },
        "error": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
        },
        "recovery": {
          "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/recovery"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "receipt",
              "postflight"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "error"
                  ]
                },
                {
                  "required": [
                    "recovery"
                  ]
                }
              ]
            },
            "properties": {
              "mutationMayHaveApplied": {
                "const": true
              },
              "retryAllowed": {
                "const": false
              },
              "groupResults": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/atomicGroupResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "committed"
                        }
                      }
                    }
                  ]
                }
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/receipt"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "terminalOutcome": {
                        "const": "applied"
                      }
                    }
                  }
                ]
              },
              "postflight": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "already-applied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "receipt",
              "postflight"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "error"
                  ]
                },
                {
                  "required": [
                    "recovery"
                  ]
                }
              ]
            },
            "properties": {
              "mutationMayHaveApplied": {
                "const": true
              },
              "retryAllowed": {
                "const": false
              },
              "groupResults": {
                "maxItems": 0
              },
              "receipt": {
                "allOf": [
                  {
                    "$ref": "urn:operon:schema:runtime:v1:extension:file-task-titles:developer-api#/$defs/receipt"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "terminalOutcome": {
                        "const": "already-applied"
                      }
                    }
                  }
                ]
              },
              "postflight": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "receipt-replay"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "postflight"
                  ]
                },
                {
                  "required": [
                    "recovery"
                  ]
                }
              ]
            },
            "properties": {
              "mutationMayHaveApplied": {
                "const": false
              },
              "retryAllowed": {
                "const": false
              },
              "groupResults": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "committed",
                          "outcome-unknown"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error",
              "recovery"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "postflight"
                  ]
                }
              ]
            },
            "properties": {
              "mutationMayHaveApplied": {
                "const": true
              },
              "retryAllowed": {
                "const": false
              },
              "error": {
                "allOf": [
                  {
                    "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "const": "outcome-unknown"
                      },
                      "retryable": {
                        "const": false
                      },
                      "action": {
                        "const": "recover-same-plan"
                      }
                    }
                  }
                ]
              },
              "groupResults": {
                "minItems": 2,
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "committed"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "const": "failed"
                        }
                      },
                      "required": [
                        "status"
                      ]
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "const": "outcome-unknown"
                          }
                        },
                        "required": [
                          "status"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "outcome-unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error",
              "recovery"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "postflight"
                  ]
                }
              ]
            },
            "properties": {
              "mutationMayHaveApplied": {
                "const": true
              },
              "retryAllowed": {
                "const": false
              },
              "error": {
                "allOf": [
                  {
                    "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "const": "outcome-unknown"
                      },
                      "retryable": {
                        "const": false
                      },
                      "action": {
                        "const": "recover-same-plan"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "pendingRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryRef",
        "planDigest",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "recoveryRef": {
          "$ref": "urn:operon:schema:runtime:v1:developer-api.schema.json#/$defs/recoveryRef"
        },
        "planDigest": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256"
        },
        "createdAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        },
        "expiresAt": {
          "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp"
        }
      }
    },
    "pendingRecoveriesResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "contractVersion",
            "kind",
