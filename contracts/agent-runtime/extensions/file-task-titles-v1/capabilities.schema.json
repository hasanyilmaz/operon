{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operon:schema:runtime:v1:extension:file-task-titles:capabilities",
  "title": "File Task titles V1 capabilities",
  "$defs": {
    "capabilityId": {
      "type": "string",
      "enum": [
        "tasks.file.create.preview",
        "tasks.file.create.apply",
        "tasks.file.title.preview",
        "tasks.file.title.apply"
      ]
    },
    "capabilityRegistry": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "mutationKind",
          "destructive"
        ],
        "properties": {
          "id": {
            "enum": [
              "tasks.file.create.preview",
              "tasks.file.create.apply",
              "tasks.file.title.preview",
              "tasks.file.title.apply"
            ]
          },
          "mode": {
            "enum": [
              "preview",
              "apply"
            ]
          },
          "mutationKind": {
            "enum": [
              "task.create",
              "task.update"
            ]
          },
          "destructive": {
            "const": false
          }
        }
      }
    }
  }
}
