{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operon:schema:runtime:v1:extension:task-workflows:read",
  "title": "Operon Runtime V1 saved-filter extension",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["exact-file", "folder-tree"] },
        "path": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" }
      }
    },
    "request": {
      "type": "object",
      "x-operon-maxUtf8Bytes": 786432,
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "kind", "consistency", "filterSetId"],
      "properties": {
        "contractVersion": { "const": 1 },
        "requestId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" },
        "kind": { "const": "task-filter-query" },
        "filterSetId": { "type": "string", "minLength": 1, "maxLength": 256, "x-operon-maxUtf8Bytes": 256 },
        "scope": { "$ref": "#/$defs/scope" },
        "include": { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/hydrations" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 250 },
        "cursor": {
          "allOf": [
            { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/cursor" },
            { "type": "string", "minLength": 16, "maxLength": 4096, "pattern": "^(?!\\s)(?:[\\s\\S]*\\S)?$" }
          ]
        },
        "consistency": { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/consistency" }
      }
    },
    "result": {
      "type": "object",
      "x-operon-maxUtf8Bytes": 3145728,
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "kind", "ok", "freshness", "warnings"],
      "properties": {
        "contractVersion": { "const": 1 },
        "requestId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" },
        "kind": { "const": "task-filter-query-result" },
        "ok": { "type": "boolean" },
        "freshness": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/freshness" },
        "warnings": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning" } },
        "contextRevision": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/contextRevision" },
        "tasks": { "type": "array", "maxItems": 250, "items": { "$ref": "urn:operon:schema:runtime:v1:context.schema.json#/$defs/taskContext" } },
        "page": { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/taskQueryPage" },
        "provenance": { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/provenance" },
        "truncations": { "$ref": "urn:operon:schema:runtime:v1:read.schema.json#/$defs/truncations" },
        "error": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/structuredError" }
      },
      "oneOf": [
        { "properties": { "ok": { "const": true } }, "required": ["contextRevision", "tasks", "page", "provenance", "truncations"], "not": { "required": ["error"] } },
        { "properties": { "ok": { "const": false } }, "required": ["error"], "allOf": [
          { "not": { "required": ["tasks"] } },
          { "not": { "required": ["page"] } },
          { "not": { "required": ["provenance"] } },
          { "not": { "required": ["truncations"] } }
        ] }
      ]
    }
  }
}
