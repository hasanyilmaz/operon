{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operon:schema:runtime:v1:extension:task-workflows:mutation",
  "title": "Operon Runtime V1 task adoption, identity template, and periodic note extension",
  "$defs": {
    "identityPlaceholderFileTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "mode", "identityPlaceholderPolicy"],
          "properties": {
            "representation": { "const": "file" },
            "mode": { "const": "configured-default" },
            "templateId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "x-operon-maxUtf8Bytes": 256 },
            "identityPlaceholderPolicy": { "const": "resolve-operon-id-v1" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "mode", "filePath", "identityPlaceholderPolicy"],
          "properties": {
            "representation": { "const": "file" },
            "mode": { "const": "exact-path" },
            "filePath": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" },
            "templateId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "x-operon-maxUtf8Bytes": 256 },
            "identityPlaceholderPolicy": { "const": "resolve-operon-id-v1" }
          }
        }
      ]
    },
    "adoptSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "lineNumber", "expectedLine"],
      "properties": {
        "filePath": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" },
        "lineNumber": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedLine": { "type": "string", "maxLength": 65536, "x-operon-maxUtf8Bytes": 65536 }
      }
    },
    "adoptPreviewIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "source"],
      "properties": {
        "operation": { "const": "adopt-inline" },
        "source": { "$ref": "#/$defs/adoptSource" },
        "statusId": { "type": "string", "minLength": 1, "maxLength": 256, "x-operon-maxUtf8Bytes": 256 },
        "terminalSourcePolicy": { "const": "reopen" }
      }
    },
    "adoptSealedSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "source", "operonId", "resultingLine", "sourceDigest", "resultDigest", "locator"],
      "properties": {
        "operation": { "const": "adopt-inline" },
        "source": { "$ref": "#/$defs/adoptSource" },
        "statusId": { "type": "string", "minLength": 1, "maxLength": 256, "x-operon-maxUtf8Bytes": 256 },
        "terminalSourcePolicy": { "const": "reopen" },
        "operonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" },
        "resolvedStatusId": { "type": "string", "minLength": 1, "maxLength": 256, "x-operon-maxUtf8Bytes": 256 },
        "resultingLine": { "type": "string", "maxLength": 65536, "x-operon-maxUtf8Bytes": 65536 },
        "sourceDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "resultDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "locator": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/inlineLocator" }
      },
      "allOf": [
        {
          "if": { "required": ["statusId"] },
          "then": { "required": ["resolvedStatusId"] },
          "else": { "not": { "required": ["resolvedStatusId"] } }
        }
      ]
    },
    "templateIdentityAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence", "operonId"],
      "properties": {
        "occurrence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "suffix": { "type": "string", "pattern": "^[0-9A-Za-z]$" },
        "operonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" }
      }
    },
    "identityCreateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "description", "target", "fields"],
      "properties": {
        "itemRef": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 65536, "x-operon-maxUtf8Bytes": 65536 },
        "target": { "$ref": "#/$defs/identityPlaceholderFileTarget" },
		"fields": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createFieldItem" } },
        "tags": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
        "statusId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "priorityId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parent": { "type": "object" },
        "related": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
        "dependencies": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
        "bodyMarkdown": { "type": "string", "maxLength": 1048576, "x-operon-maxUtf8Bytes": 1048576 }
      }
    },
    "identityCreateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "items"],
      "properties": {
        "operation": { "const": "create" },
        "items": { "type": "array", "minItems": 1, "maxItems": 64, "x-operon-uniqueBy": "itemRef", "items": { "$ref": "#/$defs/identityCreateItem" } }
      }
    },
    "periodicNoteCreateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "mode", "periodicKind"],
      "properties": {
        "representation": { "const": "inline" },
        "mode": { "const": "periodic-note" },
        "periodicKind": { "enum": ["daily", "weekly"] },
        "routeDate": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "periodicNoteCreateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "description", "target", "fields"],
      "properties": {
        "itemRef": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 65536, "x-operon-maxUtf8Bytes": 65536 },
		"target": { "$ref": "#/$defs/periodicNoteCreateTarget" },
		"fields": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createFieldItem" } },
        "tags": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
        "statusId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "priorityId": { "type": "string", "minLength": 1, "maxLength": 256 },
		"related": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createReference" } },
		"dependencies": { "type": "array", "maxItems": 64, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/createDependency" } }
      }
    },
    "periodicNoteCreateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "items"],
      "properties": {
        "operation": { "const": "create" },
        "items": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/periodicNoteCreateItem" } }
      }
    },
    "periodicNoteUpdateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target", "changes"],
      "properties": {
        "operation": { "const": "update-periodic-note" },
        "target": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/exactMutationTarget" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/generalUpdateItem" },
          "allOf": [
            { "contains": { "type": "object", "required": ["field"], "properties": { "field": { "const": "dateScheduled" } } }, "minContains": 1, "maxContains": 1 },
            { "not": { "contains": { "type": "object", "required": ["field"], "properties": { "field": { "const": "parentTask" } } } } },
            { "not": { "contains": { "type": "object", "required": ["field"], "properties": { "field": { "const": "__taskDataType" } } } } }
          ]
        }
      }
    },
    "periodicNoteUpdateSourceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "expectedState", "expectedDigest", "plannedDigest"],
      "properties": {
        "filePath": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" },
        "expectedState": { "enum": ["absent", "present"] },
        "expectedDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "plannedDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" }
      }
    },
    "periodicNoteUpdateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "periodicKind", "previousDateScheduled", "nextDateScheduled", "periodicAnchorDateKey", "notePath", "configDigest", "templatePath", "templateDigest", "container", "parentBefore", "parentAfter", "originalLocator", "sourceTransitions"],
      "properties": {
        "decision": { "enum": ["detach", "retain", "realign"] },
        "periodicKind": { "enum": ["daily", "weekly"] },
        "previousDateScheduled": { "oneOf": [{ "const": "" }, { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }] },
        "nextDateScheduled": { "oneOf": [{ "const": "" }, { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }] },
        "periodicAnchorDateKey": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }] },
        "notePath": { "oneOf": [{ "type": "null" }, { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" }] },
        "configDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "templatePath": { "oneOf": [{ "type": "null" }, { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" }] },
        "templateRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "templateDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "preparedNoteContent": { "type": "string", "maxLength": 1048576, "x-operon-maxUtf8Bytes": 1048576 },
        "container": {
          "type": "object", "additionalProperties": false, "required": ["mode", "registryState"],
          "properties": { "mode": { "enum": ["none", "existing", "create"] }, "operonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" }, "registryState": { "enum": ["not-required", "registered", "register"] } },
          "oneOf": [{ "properties": { "mode": { "const": "none" } }, "not": { "required": ["operonId"] } }, { "properties": { "mode": { "enum": ["existing", "create"] } }, "required": ["operonId"] }]
        },
        "parentBefore": { "oneOf": [{ "type": "null" }, { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" }] },
        "parentAfter": { "oneOf": [{ "type": "null" }, { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" }] },
        "originalLocator": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/taskSourceLocator" },
        "sourceTransitions": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/periodicNoteUpdateSourceTransition" } }
      },
      "allOf": [{ "if": { "properties": { "decision": { "const": "detach" } }, "required": ["decision"] }, "then": { "properties": { "notePath": { "type": "null" }, "parentAfter": { "type": "null" }, "container": { "properties": { "mode": { "const": "none" } } } } } }]
    },
    "periodicNoteRouteEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodicKind", "routeDateKey", "periodicAnchorDateKey", "routeSource", "localToday", "notePath", "headingKeyword", "configDigest", "templatePath", "templateDigest", "noteExpectedState", "noteExpectedDigest", "preparedNoteContent", "container"],
      "properties": {
        "periodicKind": { "enum": ["daily", "weekly"] },
        "routeDateKey": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "periodicAnchorDateKey": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "routeSource": { "enum": ["explicit-route-date", "date-scheduled", "datetime-start-local-date", "local-today"] },
        "localToday": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notePath": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" },
        "headingKeyword": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "configDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "templatePath": { "oneOf": [{ "type": "null" }, { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/vaultRelativePath" }] },
        "templateRevision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "templateDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "noteExpectedState": { "enum": ["absent", "present"] },
        "noteExpectedDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "preparedNoteContent": { "type": "string", "maxLength": 1048576, "x-operon-maxUtf8Bytes": 1048576 },
        "container": {
          "type": "object", "additionalProperties": false, "required": ["mode", "registryState"],
          "properties": {
            "mode": { "enum": ["none", "existing", "create"] },
            "operonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" },
            "registryState": { "enum": ["not-required", "registered", "register"] }
          },
          "oneOf": [
            { "properties": { "mode": { "const": "none" } }, "not": { "required": ["operonId"] } },
            { "properties": { "mode": { "enum": ["existing", "create"] } }, "required": ["operonId"] }
          ]
        }
      }
    },
    "identitySealedCreateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "operonId", "locator", "renderedTaskDigest", "plannedSourceDigest", "resolvedRelatedOperonIds", "templateIdentityAllocations"],
      "properties": {
        "itemRef": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "operonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" },
        "repeatSeriesId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "locator": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/taskSourceLocator" },
        "targetBeforeDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "expectedAbsence": { "const": true },
        "renderedTaskDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "plannedSourceDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "templateId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "templateDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "templateIdentityAllocations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/templateIdentityAllocation" } },
        "resolvedParentOperonId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" },
        "resolvedRelatedOperonIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/operonId" } },
        "resolvedDependencies": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
        "bodyMarkdownSummary": { "type": "object" }
      },
      "oneOf": [
        { "required": ["targetBeforeDigest"], "not": { "required": ["expectedAbsence"] } },
        { "required": ["expectedAbsence"], "not": { "required": ["targetBeforeDigest"] } }
      ]
    },
    "planCommonProperties": {
      "type": "object",
      "properties": {
        "contractVersion": { "const": 1 },
        "planId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" },
        "planHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "clientInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" },
        "idempotencyKeyHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "receiptTargetDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
        "createdAt": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp" },
        "expiresAt": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp" },
        "targets": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/planTarget" } },
        "contextRevision": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/contextRevision" },
        "affectedResources": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/affectedResourceRevisionMap" },
        "atomicGroups": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/atomicGroup" } },
        "predictedEffects": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/predictedEffect" } },
        "riskLevel": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/riskLevel" },
        "requiresConfirmation": { "type": "boolean" },
        "requiredAcknowledgements": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "warnings": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning" } }
      }
    },
    "sealedPlan": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["contractVersion", "planId", "planHash", "clientInstanceId", "correlationId", "idempotencyKeyHash", "receiptTargetDigest", "capability", "mutationKind", "createdAt", "expiresAt", "targets", "contextRevision", "affectedResources", "atomicGroups", "predictedEffects", "riskLevel", "requiresConfirmation", "requiredAcknowledgements", "warnings", "spec"],
          "properties": {
            "contractVersion": { "const": 1 }, "planId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" }, "planHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
            "clientInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "correlationId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" }, "idempotencyKeyHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" }, "receiptTargetDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
            "capability": { "const": "tasks.adopt.preview" }, "mutationKind": { "const": "task.adopt" }, "createdAt": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp" }, "expiresAt": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/auditTimestamp" },
            "targets": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/planTarget" } }, "contextRevision": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/contextRevision" }, "affectedResources": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/affectedResourceRevisionMap" },
            "atomicGroups": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/atomicGroup" } }, "predictedEffects": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:mutation.schema.json#/$defs/predictedEffect" } },
            "riskLevel": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/riskLevel" }, "requiresConfirmation": { "type": "boolean" }, "requiredAcknowledgements": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "warnings": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/warning" } }, "spec": { "$ref": "#/$defs/adoptSealedSpec" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["contractVersion", "planId", "planHash", "clientInstanceId", "correlationId", "idempotencyKeyHash", "receiptTargetDigest", "capability", "mutationKind", "createdAt", "expiresAt", "targets", "contextRevision", "affectedResources", "atomicGroups", "predictedEffects", "riskLevel", "requiresConfirmation", "requiredAcknowledgements", "warnings", "spec", "createEffects"],
          "properties": {
            "contractVersion": { "const": 1 }, "planId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" }, "planHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" }, "clientInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "correlationId": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/requestId" }, "idempotencyKeyHash": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" }, "receiptTargetDigest": { "$ref": "urn:operon:schema:runtime:v1:common.schema.json#/$defs/sha256" },
